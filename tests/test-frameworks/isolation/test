#!/bin/bash -e
. "$(dirname "$0")"/../../common.sh

bazel build :none :none-jvm
! bazel test :none
! bazel test :none-jvm

bazel build :classloader-jvm
bazel test :classloader
! bazel test :classloader-jvm

bazel build :classloader-shared
! bazel test :classloader-shared

bazel test :process :process-jvm :process-2_12

# verify framework args work for each level of isolation
! (bazel test :none | grep 'start at 1.*ms')
bazel test --test_arg=--framework_args=-showtimes :none | grep 'start at 1.*ms'
bazel test --test_arg=--framework_args=-showtimes :classloader | grep 'start at 1.*ms'
bazel test --test_arg=--framework_args=-showtimes :process | grep 'start at 1.*ms'
